#
# Env policy
# - Committed: .env.defaults (safe defaults), .env.example (documentation)
# - Not committed: .env.local / .env.staging / .env.production (secrets/overrides)
# - Select env via APP_ENV=local|staging|production
#
APP_ENV=local

PORT=8787
NODE_ENV=development
CORS_ORIGIN=http://web.localhost

# Canonical origins (preferred)
APP_ORIGIN=http://web.localhost
WEB_ORIGIN=http://web.localhost
# API is served under the same origin at /api/* via Caddy.
API_ORIGIN=http://web.localhost

# Legacy names (kept for backwards compatibility; prefer *_ORIGIN)
WEB_BASE_URL=http://web.localhost
API_BASE_URL=http://web.localhost
PUBLIC_API_BASE_URL=http://web.localhost

REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=junkmail
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
# Public reads are served via Caddy at /assets/*
MINIO_PUBLIC_URL=http://web.localhost/assets
ASSETS_PROXY_BASE=/assets

MAGIC_LINK_TTL_MINUTES=30
SESSION_TTL_DAYS=30
EMAIL_PROVIDER=unset
EMAIL_API_KEY=unset
EMAIL_FROM="junkmail <noreply@example.com>"

VOTE_HASH_SALT=dev-vote-salt
IP_HASH_SALT=dev-ip-salt
VOTE_RATE_LIMIT_BURST=20
VOTE_RATE_LIMIT_BURST_WINDOW=60
VOTE_RATE_LIMIT_SUSTAINED=240
VOTE_RATE_LIMIT_SUSTAINED_WINDOW=3600
BRADLEY_TERRY_K=0.15
RATING_INITIAL_SCORE=0
RATING_INITIAL_UNCERTAINTY=1
RATING_MIN_UNCERTAINTY=0.15
TOPLIST_MIN_COMPARISONS=10
TOPLIST_CACHE_SECONDS=90
IMAGE_CROP_ENABLED=true
IMAGE_CROP_ANALYSIS_MAX_DIM=512
IMAGE_CROP_WHITE_THRESHOLD=248
IMAGE_CROP_BLACK_THRESHOLD=8
IMAGE_CROP_LINE_DOMINANCE=0.985
IMAGE_CROP_LINE_STDDEV_MAX=16
IMAGE_CROP_MAX_TRIM_RATIO_PER_SIDE=0.18
IMAGE_CROP_MIN_REMAINING_RATIO=0.5
IMAGE_CROP_MIN_CONFIDENCE=0.8
IMAGE_CROP_MIN_TRIM_PIXELS=10
IMAGE_CROP_MIN_AREA_REMOVED_RATIO=0.01
IMAGE_CROP_RECT_DETECT_ENABLED=true
IMAGE_CROP_RECT_ANALYSIS_MAX_DIM=640
IMAGE_CROP_RECT_MIN_AREA_RATIO=0.16
IMAGE_CROP_RECT_MIN_CONFIDENCE=0.56
IMAGE_CROP_RECT_ASPECT_MIN=0.45
IMAGE_CROP_RECT_ASPECT_MAX=2.4
IMAGE_CROP_RECT_ROW_FOREGROUND_RATIO=0.12
IMAGE_CROP_RECT_COL_FOREGROUND_RATIO=0.12
IMAGE_CROP_RECT_COLOR_DISTANCE=26
IMAGE_CROP_RECT_LUMA_DISTANCE=20
IMAGE_CROP_RECT_CENTER_WEIGHT=0.35

MATCHUP_NEW_EXPOSURE=5
MATCHUP_CLOSE_SAMPLE=24
MATCHUP_CLOSE_CANDIDATE_PAIRS=6
MATCHUP_REPEAT_TTL_SECONDS=120
MATCHUP_POOL_TTL_SECONDS=10
MATCHUP_PAIR_COOLDOWN_MS=900
MATCHUP_WEIGHT_NEW=0.45
MATCHUP_WEIGHT_CLOSE=0.4
MATCHUP_WEIGHT_RANDOM=0.15

CONVEX_URL='http://localhost:3210'
CONVEX_ADMIN_KEY='convex-self-hosted|replace-me'
CONVEX_SELF_HOSTED_URL='http://localhost:3210'
CONVEX_SELF_HOSTED_ADMIN_KEY='convex-self-hosted|replace-me'
# Browser Convex URL (recommended for local dev): Caddy forwards this to Convex.
PUBLIC_CONVEX_URL=http://convex.localhost

CONVEX_SITE_URL=http://127.0.0.1:3211

# Realtime vote validation script tuning
REALTIME_TEST_USERS=100
REALTIME_TEST_VOTES_PER_USER=8
REALTIME_TEST_PROBE_VOTES=12
REALTIME_TEST_PROBE_TIMEOUT_MS=5000
REALTIME_TEST_PROBE_POLL_MS=120
REALTIME_TEST_DISCOVERY_ROUNDS=250
REALTIME_TEST_P95_TARGET_MS=300
REALTIME_TEST_UPDATE_P95_TARGET_MS=1500
REALTIME_TEST_DRAIN_TIMEOUT_MS=30000
REALTIME_TEST_DRAIN_POLL_MS=200

# Telegram ingest (optional)
# Create a bot via @BotFather, add it to your private group, and set its webhook to:
#   {API_BASE_URL}/api/v1/telegram/webhook
TELEGRAM_BOT_TOKEN=replace-me
# Comma-separated chat IDs allowed to upload (e.g. -1001234567890)
TELEGRAM_ALLOWED_CHAT_IDS=
# If set, requests must include header: X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET_TOKEN=
