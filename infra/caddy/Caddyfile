{
  # Use local CA certs for local/dev hostnames.
  local_certs
}

# Single-origin dev front door:
# - / -> Astro (host dev server)
# - /api/* -> API (host dev server)
# - /assets/* -> MinIO (minio container)
#
# Upstreams are provided via env vars so the same Caddyfile works for:
# - host-run app servers (bun run dev:all) + Docker infra
(web_frontdoor) {
  handle /api/* {
    reverse_proxy {env.API_UPSTREAM}
  }

  handle_path /assets/* {
    reverse_proxy {env.MINIO_UPSTREAM}
  }

  reverse_proxy {env.WEB_UPSTREAM}
}

# Local stable hostname.
web.localhost {
  import web_frontdoor
}

# Cloudflare Tunnel quick URLs (random trycloudflare hostnames).
http://*.trycloudflare.com {
  import web_frontdoor
}

# Direct service hostnames (optional, but useful for debugging).
api.localhost {
  reverse_proxy {env.API_UPSTREAM}
}

minio.localhost {
  reverse_proxy {env.MINIO_UPSTREAM}
}

minio-console.localhost {
  reverse_proxy {env.MINIO_CONSOLE_UPSTREAM}
}

convex.localhost {
  reverse_proxy {env.CONVEX_UPSTREAM}
}

convex-site.localhost {
  reverse_proxy {env.CONVEX_SITE_UPSTREAM}
}
