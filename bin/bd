#!/usr/bin/env bash
set -euo pipefail

wrapper_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

find_real_bd() {
  if [[ -n "${BD_REAL:-}" ]]; then
    if [[ -x "$BD_REAL" ]]; then
      printf '%s\n' "$BD_REAL"
      return 0
    fi
    printf 'bin/bd: BD_REAL is set but not executable: %s\n' "$BD_REAL" >&2
    return 127
  fi

  local p abs
  IFS=':' read -r -a path_parts <<< "${PATH:-}"
  for p in "${path_parts[@]}"; do
    [[ -z "$p" ]] && p="."
    abs="$(cd -- "$p" 2>/dev/null && pwd -P || true)"
    [[ -n "$abs" && "$abs" == "$wrapper_dir" ]] && continue
    if [[ -x "$p/bd" ]]; then
      printf '%s\n' "$p/bd"
      return 0
    fi
  done

  printf 'bin/bd: could not find real bd in PATH (set BD_REAL=/path/to/bd to override)\n' >&2
  return 127
}

real_bd="$(find_real_bd)"

# Run bd first; preserve its exit code and stdout/stderr exactly.
"$real_bd" "$@"
status=$?

# "Task completed" maps to a successful `bd close ...`.
if [[ $status -eq 0 && "${1:-}" == "close" ]]; then
  # Try to play a WAV if available; fall back to a terminal bell.
  # This wrapper must never affect bd output or exit status.
  if [[ -w /dev/tty ]]; then
    (
      if command -v play-wav >/dev/null 2>&1; then
        play-wav >/dev/null 2>&1 || printf '\a' > /dev/tty
      else
        printf '\a' > /dev/tty
      fi
    ) >/dev/null 2>&1 &
  fi
fi

exit "$status"
