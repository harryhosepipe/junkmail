#!/usr/bin/env bash
set -euo pipefail

# Repo-local WAV player used by ./bin/bd.
# Prefer Linux audio backends so it works in environments where Windows interop
# (running /mnt/c/.../*.exe) is blocked (e.g. sandboxed runners).

DEFAULT_WAV_PATH="/mnt/c/Users/pablo/Nextcloud/Documents/sounds/levelup.wav"

wav_path="${1:-${BD_CLOSE_WAV:-$DEFAULT_WAV_PATH}}"
if [[ -z "$wav_path" ]]; then
  exit 0
fi

if [[ ! -f "$wav_path" ]]; then
  exit 0
fi

try() {
  # Run a command; return success/failure without exiting the script.
  set +e
  local -a timeout_prefix=()
  if command -v timeout >/dev/null 2>&1; then
    timeout_prefix=(timeout 5s)
  fi

  "${timeout_prefix[@]}" "$@" >/dev/null 2>&1
  local status=$?
  set -e
  return "$status"
}

# Best-effort: try likely-available Linux players first (WSLg audio typically works via PulseAudio/PipeWire).
if command -v paplay >/dev/null 2>&1; then
  if try paplay "$wav_path"; then exit 0; fi
fi

if command -v pw-play >/dev/null 2>&1; then
  if try pw-play "$wav_path"; then exit 0; fi
fi

if command -v aplay >/dev/null 2>&1; then
  if try aplay -q "$wav_path"; then exit 0; fi
fi

if command -v mpv >/dev/null 2>&1; then
  if try mpv --no-video --really-quiet "$wav_path"; then exit 0; fi
fi

if command -v ffplay >/dev/null 2>&1; then
  if try ffplay -nodisp -autoexit -loglevel error "$wav_path"; then exit 0; fi
fi

# Last resort: Windows backend (may be blocked in some environments).
if command -v powershell.exe >/dev/null 2>&1 && command -v wslpath >/dev/null 2>&1; then
  windows_path="$(wslpath -w "$wav_path")"
  if try powershell.exe -NoProfile -Command "(New-Object Media.SoundPlayer \"$windows_path\").PlaySync()"; then
    exit 0
  fi
fi

exit 1
