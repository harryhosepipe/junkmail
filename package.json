{
  "name": "junkmail",
  "private": true,
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts",
    "format": "prettier -w .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2"
  }
}
