# Non-secret defaults shared across environments.
# Secrets must live in .env.local / .env.staging / .env.production (gitignored).

APP_ENV=local

# API runtime
NODE_ENV=development
PORT=8787

# Local dev front door (Caddy)
APP_ORIGIN=http://web.localhost
WEB_ORIGIN=http://web.localhost
# API is served under the same origin at /api/* via Caddy.
API_ORIGIN=http://web.localhost

WEB_BASE_URL=http://web.localhost
API_BASE_URL=http://web.localhost
PUBLIC_API_BASE_URL=http://web.localhost
CORS_ORIGIN=http://web.localhost

# Local infra defaults (docker-compose)
DATABASE_URL=postgres://junkmail:junkmail@localhost:5433/junkmail
REDIS_URL=redis://localhost:6379

MINIO_ENDPOINT=localhost
MINIO_PORT=9010
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=junkmail
MINIO_USE_SSL=false
# Public reads are served via Caddy at /assets/*
MINIO_PUBLIC_URL=http://web.localhost/assets
