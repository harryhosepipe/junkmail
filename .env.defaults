# Non-secret defaults shared across environments.
# Secrets must live in .env.local / .env.staging / .env.production (gitignored).

APP_ENV=local

# API runtime
NODE_ENV=development
PORT=8787

# Legacy origins (will be updated when Caddy front door lands)
WEB_BASE_URL=http://localhost:4321
API_BASE_URL=http://localhost:8787
PUBLIC_API_BASE_URL=http://localhost:8787
CORS_ORIGIN=http://localhost:4321

# Local infra defaults (docker-compose)
DATABASE_URL=postgres://junkmail:junkmail@localhost:5433/junkmail
REDIS_URL=redis://localhost:6379

