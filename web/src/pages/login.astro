---
import Base from "../layouts/Base.astro";
import LoginForm from "../components/LoginForm.svelte";
import { publicApiBaseUrl, serverApiBaseUrl } from "../lib/apiBase";

export const prerender = false;
const error = Astro.url.searchParams.get("error");
const cookieHeader = Astro.request.headers.get("cookie") ?? "";
let authUser = null;

if (cookieHeader) {
  try {
    const response = await fetch(`${serverApiBaseUrl}/api/v1/auth/me`, {
      headers: {
        cookie: cookieHeader
      }
    });
    if (response.ok) {
      const data = await response.json();
      authUser = data?.user ?? null;
    }
  } catch (err) {
    authUser = null;
  }
}
---

<Base title="Junkmail - Login" description="Invite-only uploader login." authUser={authUser}>
  <section class="hero">
    <div class="headline">Login</div>
    <p class="subtle">Magic link only. No passwords, no nonsense.</p>
  </section>

  <section class="panel" style="margin-top: 24px;">
    <LoginForm apiBaseUrl={publicApiBaseUrl} error={error ?? ""} client:load />
  </section>
</Base>
