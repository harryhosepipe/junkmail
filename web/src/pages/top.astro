---
import Base from "../layouts/Base.astro";
import TopList from "../components/TopList.svelte";

export const prerender = true;
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8787";
---

<Base title="Junkmail - Toplist" description="Highest ranked junkmail images.">
  <section class="hero">
    <div class="headline">Toplist</div>
    <p class="subtle">Ranked by pairwise wins. No ties, no mercy.</p>
  </section>

  <section class="panel" style="margin-top: 24px;">
    <TopList apiBaseUrl={apiBaseUrl} client:visible />
  </section>
</Base>
