---
import Base from "../../layouts/Base.astro";
import ShareLink from "../../components/ShareLink.svelte";
import { serverApiBaseUrl } from "../../lib/apiBase.server";

export const prerender = false;
const { id } = Astro.params;
type VariantFormat = "avif" | "webp" | "jpg" | "png";
type VariantAsset = {
  avif?: string;
  webp?: string;
  jpg?: string;
  png?: string;
  width?: number;
};

type ImageVariants = {
  thumb?: VariantAsset;
  feed?: VariantAsset;
  full?: VariantAsset;
};

type ImageDetails = {
  id: string;
  status: string;
  title?: string | null;
  description?: string | null;
  uploaderAlias?: string | null;
  originalUrl?: string | null;
  variantUrls?: unknown;
  score?: number;
  votes?: number;
  comments?: Array<{
    id: string;
    body: string;
    userAlias?: string | null;
    createdAt?: string | null;
  }>;
};

let image: ImageDetails | null = null;
let error = "";

const normalizeVariants = (value: unknown): ImageVariants => {
  if (!value) return {};
  if (typeof value === "string") {
    try {
      return JSON.parse(value) as ImageVariants;
    } catch {
      return {};
    }
  }
  return value as ImageVariants;
};

const buildSrcset = (variants: ImageVariants, format: VariantFormat | "") => {
  if (!variants || !format) return "";
  const sizes: Array<keyof ImageVariants> = ["thumb", "feed", "full"];
  const entries = sizes
    .map((size) => {
      const variant = variants?.[size];
      const url = variant?.[format];
      const width = variant?.width;
      if (!url || !width) return "";
      return `${url} ${width}w`;
    })
    .filter(Boolean);
  return entries.join(", ");
};

const pickFallbackFormat = (variants: ImageVariants): "jpg" | "png" | "" => {
  const sizes: Array<keyof ImageVariants> = ["full", "feed", "thumb"];
  for (const size of sizes) {
    const variant = variants?.[size];
    if (variant?.jpg) return "jpg";
    if (variant?.png) return "png";
  }
  return "";
};

const pickFallbackUrl = (variants: ImageVariants, originalUrl?: string | null) => {
  const sizes: Array<keyof ImageVariants> = ["full", "feed", "thumb"];
  for (const size of sizes) {
    const variant = variants?.[size];
    if (variant?.webp) return variant.webp;
    if (variant?.avif) return variant.avif;
    if (variant?.jpg) return variant.jpg;
    if (variant?.png) return variant.png;
  }
  return originalUrl || "";
};

if (id) {
  try {
    const response = await fetch(`${serverApiBaseUrl}/api/v1/images/${id}`);
    if (response.ok) {
      image = await response.json();
    } else {
      error = "Image not found.";
    }
  } catch (err) {
    error = "Could not load this image.";
  }
} else {
  error = "Image not found.";
}

const variants = normalizeVariants(image?.variantUrls);
const fallbackFormat = pickFallbackFormat(variants);
const imageSrc = pickFallbackUrl(variants, image?.originalUrl);
const avifSrcset = buildSrcset(variants, "avif");
const webpSrcset = buildSrcset(variants, "webp");
const fallbackSrcset = buildSrcset(variants, fallbackFormat);
const score = Number(image?.score ?? 0);
const votes = Number(image?.votes ?? 0);
const pageTitle = image?.title ? `Junkmail - ${image.title}` : `Junkmail - ${id ?? "Image"}`;
const pageDescription = image?.description || "Single junkmail image detail.";
const requestUrl = new URL(Astro.request.url);
const canonicalUrl = new URL(`/image/${id ?? ""}`.replace(/\/$/, ""), requestUrl.origin).toString();
const ogImage = imageSrc;
---

<Base title={pageTitle} description={pageDescription}>
  <meta slot="head" property="og:title" content={pageTitle} />
  <meta slot="head" property="og:description" content={pageDescription} />
  <meta slot="head" property="og:type" content="website" />
  <meta slot="head" property="og:url" content={canonicalUrl} />
  {ogImage ? <meta slot="head" property="og:image" content={ogImage} /> : null}
  <meta slot="head" name="twitter:card" content="summary_large_image" />
  <meta slot="head" name="twitter:title" content={pageTitle} />
  <meta slot="head" name="twitter:description" content={pageDescription} />
  {ogImage ? <meta slot="head" name="twitter:image" content={ogImage} /> : null}
  <div class="detail-back-wrap">
    <button type="button" class="detail-back-btn" id="detail-back-btn">Back</button>
  </div>
  <section class="hero">
    <div class="headline">{image?.title || `Junkmail #${id}`}</div>
    <p class="subtle">{image?.description || "One piece of mail, judged without mercy."}</p>
  </section>

  <section class="panel detail-panel">
    {error ? (
      <div class="detail-empty">{error}</div>
    ) : image ? (
      <>
        <div class="detail-layout">
          <div class="detail-image">
            {image?.status === "public" && imageSrc ? (
              <picture>
                {avifSrcset ? (
                  <source
                    type="image/avif"
                    srcset={avifSrcset}
                    sizes="(max-width: 900px) 100vw, 720px"
                  />
                ) : null}
                {webpSrcset ? (
                  <source
                    type="image/webp"
                    srcset={webpSrcset}
                    sizes="(max-width: 900px) 100vw, 720px"
                  />
                ) : null}
                <img
                  src={imageSrc}
                  srcset={fallbackSrcset}
                  sizes="(max-width: 900px) 100vw, 720px"
                  alt={image?.title || "Junkmail image"}
                  loading="eager"
                  decoding="async"
                />
              </picture>
            ) : (
              <div class="detail-processing">Processing</div>
            )}
          </div>
          <div class="detail-meta">
            <div class="detail-stat">Uploaded by</div>
            <div class="detail-value detail-value-sm">{image?.uploaderAlias || "Unknown"}</div>
            <div class="detail-stat">Appearances</div>
            <div class="detail-value">{votes}</div>
            <div class="detail-stat" style="margin-top: 12px;">Score</div>
            <div class="detail-value">{score.toFixed(2)}</div>
            <div class="detail-stat" style="margin-top: 12px;">Comments</div>
            <div class="comments-wrap" id="comment-list">
              {Array.isArray(image.comments) && image.comments.length ? (
                image.comments.map((comment) => (
                  <article class="comment-row" data-comment-id={comment.id}>
                    <div class="comment-meta">
                      <span class="comment-author">{comment.userAlias || "Unknown"}</span>
                      <span>{comment.createdAt ? new Date(comment.createdAt).toLocaleString() : ""}</span>
                    </div>
                    <p>{comment.body}</p>
                  </article>
                ))
              ) : (
                <div class="comment-empty" id="comment-empty">No comments yet.</div>
              )}
            </div>
            <div class="comment-composer" data-comments-root data-image-id={image.id}>
              <a class="comment-login" href="/login" id="comment-login">Log in to comment</a>
              <div id="comment-editor" hidden>
                <label class="detail-stat" for="comment-body" style="margin-top: 8px;">Add comment</label>
                <textarea
                  id="comment-body"
                  class="comment-input"
                  rows="3"
                  maxlength="500"
                  placeholder="Say something about this junkmail..."
                ></textarea>
                <div class="comment-footer">
                  <span id="comment-count">0/500</span>
                  <button type="button" class="comment-submit" id="comment-submit">Post comment</button>
                </div>
                <div class="comment-error" id="comment-error"></div>
              </div>
            </div>
            <div class="admin-actions" id="admin-actions" hidden>
              <button type="button" class="comment-submit" id="admin-delete-image">Delete image</button>
              <div class="comment-error" id="admin-delete-error"></div>
            </div>
            <div class="detail-share">
              <ShareLink url={canonicalUrl} client:load />
            </div>
          </div>
        </div>
      </>
    ) : (
      <div class="detail-empty">Image not found.</div>
    )}
  </section>
</Base>

{image ? (
  <script is:inline>
    const backBtn = document.getElementById("detail-back-btn");
    backBtn?.addEventListener("click", () => {
      if (window.history.length > 1) {
        window.history.back();
        return;
      }
      window.location.href = "/";
    });

    const root = document.querySelector("[data-comments-root]");
    if (root) {
      const imageId = root.getAttribute("data-image-id");
      const loginEl = document.getElementById("comment-login");
      const editorEl = document.getElementById("comment-editor");
      const inputEl = document.getElementById("comment-body");
      const submitEl = document.getElementById("comment-submit");
      const errorEl = document.getElementById("comment-error");
      const adminActionsEl = document.getElementById("admin-actions");
      const adminDeleteEl = document.getElementById("admin-delete-image");
      const adminDeleteErrorEl = document.getElementById("admin-delete-error");
      const listEl = document.getElementById("comment-list");
      const emptyEl = document.getElementById("comment-empty");
      const countEl = document.getElementById("comment-count");

      const formatDate = (value) => {
        if (!value) return "";
        const parsed = new Date(value);
        if (Number.isNaN(parsed.getTime())) return "";
        return parsed.toLocaleString();
      };

      const setError = (value) => {
        if (errorEl) errorEl.textContent = value || "";
      };
      const setAdminDeleteError = (value) => {
        if (adminDeleteErrorEl) adminDeleteErrorEl.textContent = value || "";
      };

      const appendComment = (comment) => {
        if (!listEl || !comment) return;
        if (emptyEl) emptyEl.remove();
        const node = document.createElement("article");
        node.className = "comment-row";
        const meta = document.createElement("div");
        meta.className = "comment-meta";
        const author = document.createElement("span");
        author.className = "comment-author";
        author.textContent = comment.userAlias || "Unknown";
        const time = document.createElement("span");
        time.textContent = formatDate(comment.createdAt);
        const bodyEl = document.createElement("p");
        bodyEl.textContent = comment.body || "";
        meta.append(author, time);
        node.append(meta, bodyEl);
        listEl.appendChild(node);
      };

      const updateCount = () => {
        if (!countEl || !inputEl) return;
        countEl.textContent = `${inputEl.value.trim().length}/500`;
      };

      updateCount();
      inputEl?.addEventListener("input", updateCount);

      fetch(`/api/v1/auth/me`, { credentials: "include" })
        .then((response) => (response.ok ? response.json() : null))
        .then((data) => {
          if (data?.user) {
            if (loginEl) loginEl.hidden = true;
            if (editorEl) editorEl.hidden = false;
          }
          if (
            (data?.user?.role === "admin" || data?.user?.role === "uploader") &&
            adminActionsEl
          ) {
            adminActionsEl.hidden = false;
          }
        })
        .catch(() => null);

      adminDeleteEl?.addEventListener("click", async () => {
        if (!imageId || adminDeleteEl.hasAttribute("disabled")) return;
        setAdminDeleteError("");
        const confirmed = window.confirm("Delete this image permanently?");
        if (!confirmed) return;
        adminDeleteEl.setAttribute("disabled", "true");
        adminDeleteEl.textContent = "Deleting...";
        try {
          const response = await fetch(`/api/v1/images/${imageId}`, {
            method: "DELETE",
            credentials: "include",
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) {
            setAdminDeleteError(data?.error?.message || "Could not delete image.");
            return;
          }
          window.location.href = "/";
        } catch {
          setAdminDeleteError("Could not delete image.");
        } finally {
          adminDeleteEl.removeAttribute("disabled");
          adminDeleteEl.textContent = "Delete image";
        }
      });

      submitEl?.addEventListener("click", async () => {
        if (!imageId || !inputEl || submitEl.hasAttribute("disabled")) return;
        const body = inputEl.value.trim();
        if (!body) {
          setError("Comment cannot be empty.");
          return;
        }
        if (body.length > 500) {
          setError("Comment cannot exceed 500 characters.");
          return;
        }

        setError("");
        submitEl.setAttribute("disabled", "true");
        submitEl.textContent = "Posting...";
        try {
          const response = await fetch(`/api/v1/images/${imageId}/comments`, {
            method: "POST",
            credentials: "include",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ body }),
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) {
            setError(data?.error?.message || "Could not post comment.");
            return;
          }
          appendComment(data?.comment);
          inputEl.value = "";
          updateCount();
        } catch {
          setError("Could not post comment.");
        } finally {
          submitEl.removeAttribute("disabled");
          submitEl.textContent = "Post comment";
        }
      });
    }
  </script>
) : null}

<style>
  :global(body) {
    overflow: hidden;
  }

  :global(.shell) {
    height: 100vh;
    height: 100dvh;
    padding-bottom: 24px;
    display: grid;
    grid-template-rows: auto 1fr;
  }

  :global(main) {
    min-height: 0;
    display: grid;
    grid-template-rows: auto auto 1fr;
    overflow: hidden;
  }

  :global(.footer) {
    display: none;
  }

  .detail-back-wrap {
    margin-bottom: 12px;
  }

  .detail-back-btn {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 8px 14px;
    font: inherit;
    background: #2b3248;
    color: var(--bg-ink);
    cursor: pointer;
  }

  .detail-panel {
    margin-top: 20px;
    height: 100%;
    overflow: hidden;
    min-height: 0;
  }

  .detail-layout {
    display: grid;
    grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr);
    gap: 20px;
    align-items: stretch;
    height: 100%;
  }

  .detail-image {
    width: 100%;
    height: 100%;
    min-height: 0;
    border-radius: 18px;
    border: 1px solid var(--border);
    background: #1f2436;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .detail-image picture,
  .detail-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .detail-processing {
    color: var(--ink-muted);
    font-size: 14px;
  }

  .detail-meta {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 16px;
    background: #23293d;
    display: grid;
    gap: 4px;
    box-shadow: var(--shadow);
    min-height: 0;
    overflow: auto;
  }

  .detail-stat {
    font-size: 12px;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .detail-value {
    font-size: 22px;
    font-weight: 700;
    color: var(--bg-ink);
  }

  .detail-value-sm {
    font-size: 18px;
  }

  .detail-share {
    margin-top: 16px;
  }

  .comments-wrap {
    display: grid;
    gap: 8px;
    max-height: 260px;
    overflow: auto;
    padding-right: 4px;
  }

  .comment-row {
    margin: 0;
    padding: 10px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: #262d42;
  }

  .comment-row p {
    margin: 6px 0 0;
    font-size: 14px;
    color: var(--bg-ink);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .comment-meta {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font-size: 11px;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .comment-author {
    color: var(--bg-ink);
    font-weight: 700;
  }

  .comment-empty {
    font-size: 13px;
    color: var(--ink-muted);
  }

  .comment-composer {
    margin-top: 8px;
    display: grid;
    gap: 6px;
  }

  .admin-actions {
    margin-top: 10px;
    display: grid;
    gap: 6px;
  }

  .comment-login {
    font-size: 13px;
    color: var(--bg-ink);
  }

  .comment-input {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 10px 12px;
    font: inherit;
    color: var(--bg-ink);
    background: white;
    resize: vertical;
  }

  .comment-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: var(--ink-muted);
  }

  .comment-submit {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 8px 12px;
    font: inherit;
    background: #2b3248;
    color: var(--bg-ink);
    cursor: pointer;
  }

  .comment-submit[disabled] {
    opacity: 0.65;
    cursor: progress;
  }

  .comment-error {
    min-height: 18px;
    font-size: 13px;
    color: #9a2e1f;
  }

  .detail-empty {
    padding: 24px;
    border-radius: 16px;
    border: 1px dashed var(--border);
    background: #1f2436;
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .detail-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
