---
import Base from "../../layouts/Base.astro";

export const prerender = false;
const { id } = Astro.params;
---

<Base title={`Junkmail - ${id ?? "Image"}`} description="Single junkmail image detail.">
  <section class="hero">
    <div class="headline">Junkmail #{id}</div>
    <p class="subtle">One piece of mail, judged without mercy.</p>
  </section>

  <section class="panel" style="margin-top: 24px;">
    <div class="vote-card" style="min-height: 360px;">Full image here</div>
    <div class="muted-list" style="margin-top: 16px;">
      <span>Votes: --</span>
      <span>Score: --</span>
    </div>
  </section>
</Base>
