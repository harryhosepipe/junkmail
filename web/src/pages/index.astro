---
import Base from "../layouts/Base.astro";
import HomeFeed from "../components/HomeFeed.svelte";
import VoteModule from "../components/VoteModule.svelte";

export const prerender = true;
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL ?? "http://localhost:8787";
---

<Base title="Junkmail" description="Public gallery of junkmail images with fast voting.">
  <section class="hero">
    <div class="headline">The best junkmail, ranked mercilessly.</div>
    <p class="subtle">
      Vote fast. No ties. Every matchup makes the list smarter.
    </p>
    <div class="muted-list">
      <span class="chip">Anonymous voting</span>
      <span class="chip">Invite-only uploads</span>
      <span class="chip">Bias-resistant rankings</span>
    </div>
  </section>

  <section class="panel" style="margin-top: 28px;">
    <div class="headline" style="font-size: 22px;">Pick one</div>
    <div style="margin-top: 16px;">
      <VoteModule apiBaseUrl={apiBaseUrl} client:load />
    </div>
  </section>

  <section class="panel" style="margin-top: 24px;">
    <div class="headline" style="font-size: 22px;">Fresh + Top mix</div>
    <HomeFeed apiBaseUrl={apiBaseUrl} client:visible />
  </section>
</Base>
