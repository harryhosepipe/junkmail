---
import Base from "../layouts/Base.astro";
---

<Base title="Junkmail - Upload" description="Invite-only uploads.">
  <section class="hero">
    <div class="headline">Upload</div>
    <p class="subtle">Invite-only. JPG and PNG only. The rest will be ignored.</p>
  </section>

  <section class="panel" style="margin-top: 24px;">
    <p class="subtle">Upload form lands here.</p>
    <a class="cta" href="/login">Request access</a>
  </section>
</Base>
