---
import Base from "../layouts/Base.astro";
import UploadForm from "../features/uploads/components/UploadForm.svelte";
import { serverApiBaseUrl } from "../lib/apiBase.server";

export const prerender = false;
const cookieHeader = Astro.request.headers.get("cookie") ?? "";
let authUser = null;

if (cookieHeader) {
  try {
    const response = await fetch(`${serverApiBaseUrl}/api/v1/auth/me`, {
      headers: {
        cookie: cookieHeader
      }
    });
    if (response.ok) {
      const data = await response.json();
      authUser = data?.user ?? null;
    }
  } catch (err) {
    authUser = null;
  }
}
---

<Base title="Junkmail - Upload" description="Invite-only uploads." authUser={authUser}>
  <section class="hero">
    <div class="headline">Upload</div>
    <p class="subtle">Invite-only. JPG and PNG only. The rest will be ignored.</p>
  </section>

  <section class="panel" style="margin-top: 24px;">
    <UploadForm initialUser={authUser} client:load />
  </section>
</Base>
