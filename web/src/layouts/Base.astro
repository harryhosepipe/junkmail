---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import AuthIndicator from "../components/AuthIndicator.svelte";

const {
  title = "Junkmail",
  description = "Public junkmail gallery and voting.",
  authUser = null
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <div class="brand">junkmail</div>
        <nav class="nav">
          <a href="/">Home</a>
          <a href="/top">Toplist</a>
          <a href="/upload">Upload</a>
          <a href="/login">Login</a>
        </nav>
        <AuthIndicator
          initialUser={authUser}
          client:load
          transition:persist
        />
        <details class="mobile-nav">
          <summary class="mobile-nav-toggle">Menu</summary>
          <nav class="mobile-nav-links">
            <a href="/">Home</a>
            <a href="/top">Toplist</a>
            <a href="/upload">Upload</a>
            <a href="/login">Login</a>
          </nav>
        </details>
      </header>
      <main>
        <slot />
      </main>
      <footer class="footer">
        Dry humor. Serious ranking.
      </footer>
    </div>
  </body>
</html>
